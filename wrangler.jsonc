{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimpquizz",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true },
  // avant chaque déploiement (et en local) : liste les fichiers de public/media/<dossier>/ → src/media-index.js
  "build": { "command": "node scripts/build-media.mjs && node scripts/build-questions.mjs", "watch_dir": ["src", "public/media", "questions"] },
  // garde les variables saisies dans le tableau de bord Cloudflare (ex. GM_PIN) à chaque déploiement
  "keep_vars": true
}
